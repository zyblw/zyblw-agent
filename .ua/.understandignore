# 第三方 Cursor skills 副本，不属于 zyblw-agent 运行时。
.agents/

# 本工具自己的分析产物。
.ua/

# IDE / 构建输出（与 .gitignore 一致，避免脏工作区混入）。
**/.bloop/
**/.bsp/
**/.metals/
**/.scala-build/
