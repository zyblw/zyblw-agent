# Metals / Bloop / BSP are generated per checkout. Metals may create an extra
# project/metals.sbt (and nested project directories) for every sbt build it imports.
**/.bloop/
**/.bsp/
**/.metals/
**/.scala-build/
**/metals.sbt
project/project/
project/target/
target/
**/target/

# Keep shared VS Code recommendations and safe tasks, but never machine settings,
# launch configurations, or extension caches.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
.vscode/*.local
# Understand Anything writes a local architecture graph under .ua/.
# The graph, fingerprints, and scratch batches are regenerated from source
# and stay on this machine. Share only the analysis policy.
.ua/*
!.ua/.understandignore
!.ua/config.json

.idea/
.DS_Store
**/__pycache__/
*.py[cod]
