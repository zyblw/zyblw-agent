# 复制为 .env 后由 Compose 读取。密码与 API Key 只放在环境或 secret file，不要打印进日志。

ZYBLW_AGENT_RUNTIME_MODE=live
ZYBLW_AGENT_AUTH_MODE=trusted-headers
ZYBLW_AGENT_BIND_ADDRESS=127.0.0.1
ZYBLW_AGENT_HTTP_PORT=8080
ZYBLW_AGENT_WORKER_ID=support-host-1

# 使用发布镜像时设置精确版本或 digest；compose.business.yml 留空会从本仓库构建。
# ZYBLW_AGENT_IMAGE=ghcr.io/your-org/zyblw-agent-support:immutable-version

# Docker 容器访问同一台机器上的 PostgreSQL 时用 host.docker.internal。
# 数据库必须监听该地址（不要只绑 127.0.0.1），或改成局域网 IP。
ZYBLW_AGENT_JDBC_URL=jdbc:postgresql://host.docker.internal:5432/zyblw_agent
ZYBLW_AGENT_DB_USER=zyblw_agent
ZYBLW_AGENT_DB_PASSWORD_ENV=ZYBLW_AGENT_DB_PASSWORD
ZYBLW_AGENT_DB_PASSWORD=change-me
# 可选 preflight 连接探针；不要在 URL 中写密码。
# ZYBLW_AGENT_PSQL_URL=postgresql://host.docker.internal:5432/zyblw_agent?sslmode=require

# 可选。不设则 migrate 与 serve 使用同一数据库账号，适合当前单库单用户部署。
# ZYBLW_AGENT_MIGRATION_USER=zyblw_migrate
# ZYBLW_AGENT_MIGRATION_PASSWORD=change-me-migrate

# 模型入口二选一。
# A. 单一 OpenAI-compatible 端点（默认示例）。模型名使用你的账号/中转站实际部署 ID。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-me
OPENAI_MODEL=replace-with-deployment-model-id

# B. 多端点或中转站。启用时清空上面三个 OPENAI_*；apiKeyEnv 必须与容器中注入的变量同名。
# 参考 Compose 已内置 RELAY/DEEPSEEK/GLM/QWEN/MOONSHOT/OPENAI/ANTHROPIC/GEMINI 的标准密钥名；
# 自定义密钥名必须先显式加入 Compose support.environment，preflight 会阻止遗漏注入。
# ZYBLW_AGENT_PROVIDER_ENDPOINTS_JSON={"defaultProvider":"relay","endpoints":[{"providerId":"relay","baseUrl":"https://gateway.example/v1","apiKeyEnv":"RELAY_API_KEY","defaultModel":"replace-with-relay-model-id","protocol":"relay","compatibilityProfile":"openai"}]}
# RELAY_API_KEY=replace-me
# DEEPSEEK_API_KEY=replace-me
# GLM_API_KEY=replace-me
# QWEN_API_KEY=replace-me
# MOONSHOT_API_KEY=replace-me
# ANTHROPIC_API_KEY=replace-me
# GEMINI_API_KEY=replace-me

# 问答知识库与聊天凭据分开。维度必须与 1024 schema 一致，live 模式不会回退 HashEmbedding。
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=replace-me
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1024
# ZYBLW_AGENT_BOOKS_DIR=data/books

# 可选。留空则不导出 OTLP，不影响 Run 正确性。
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
