# zyblw-agent 控制台的构建期配置。
#
# 这里只有一个变量，而且它只是**默认值**：控制台在运行时可以切换后端地址，因为同一份静态构建通常会被
# 用来连开发、预发和生产实例。把地址烧进镜像会迫使每个环境重新构建一次。
#
# Langfuse、Grafana 和 OTLP 端点刻意**不**在这里配置。它们由后端通过
# GET /api/v1/admin/capabilities 下发（对应 ZYBLW_AGENT_OBSERVABILITY_* 环境变量），这样一次后端部署
# 配置就能同时纠正所有页面的跳转目标，而不需要重新构建前端。

# 后端根地址的默认值。
NEXT_PUBLIC_AGENT_BASE_URL=http://localhost:8080

# 独立运维台使用 bearer；嵌入宿主站点并通过 HttpOnly Cookie/BFF 认证时使用 host-session。
NEXT_PUBLIC_AGENT_AUTH_MODE=bearer

# 嵌入子路径时设置，例如 /admin/agent；独立部署保持为空。
NEXT_PUBLIC_AGENT_BASE_PATH=
