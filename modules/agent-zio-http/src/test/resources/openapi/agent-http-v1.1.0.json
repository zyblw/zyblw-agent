          },
          "404" : {
            "description" : "稳定错误分类与可安全展示的消息；不会返回内部异常或 Provider 正文。\n\n",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/commands/{commandId}/retry" : {
      "description" : "人工重试 DeadLetter 命令。\n\n- Commands\n",
      "post" : {
        "tags" : [
          "Commands"
        ],
        "description" : "人工重试 DeadLetter 命令。\n\n- Commands\n",
        "parameters" : [
          {
