  },
  "components" : {
    "schemas" : {
      "ApprovalCommand" : {
        "type" : "object",
        "properties" : {
          "decision" : {
            "type" : "string"
          },
          "reason" : {
            "type" : [
              "string",
              "null"
            ],
            "description" : "If not set, this field defaults to the value of the default annotation.",
            "default" : null
          }
        },
        "required" : [
          "decision"
        ],
        "description" : "审批命令。\n@param decision\n只允许 `approve` 或 `reject`，由实现层 fail-closed 校验\n@param reason\n拒绝或人工决策的低敏说明；不得携带密钥和完整医疗隐私"
      },
      "ApprovalView" : {
        "type" : "object",
        "properties" : {
          "requestedAtEpochMilli" : {
            "type" : "integer",
            "format" : "int64"
          },
          "risk" : {
            "type" : "string"
          },
          "reason" : {
            "type" : "string"
          },
          "toolName" : {
            "type" : "string"
          },
          "approvalId" : {
            "type" : "string"
          }
        },
        "required" : [
          "approvalId",
          "toolName",
          "risk",
          "reason",
          "requestedAtEpochMilli"
        ],
        "description" : "等待人工介入时公开的最小审批视图，不包含完整工具参数。\n@param approvalId\n恢复命令必须关联的稳定审批 ID\n@param toolName\n模型提议调用的工具名称\n@param risk\n工具注册时确定的风险等级，不由模型自行声明\n@param reason\n经过长度限制的低敏审批原因\n@param requestedAtEpochMilli\n审批请求写入耐久状态的 UTC epoch 毫秒"
      },
      "CancelCommand" : {
        "type" : "object",
        "properties" : {
          "reason" : {
            "type" : [
              "string",
              "null"
            ],
            "description" : "If not set, this field defaults to the value of the default annotation.",
            "default" : null
          }
        },
        "description" : "@param reason 取消 Run 的可选低敏原因；身份仍从可信认证上下文取得。"
      },
      "CommandReceipt" : {
        "type" : "object",
        "properties" : {
          "commandId" : {
            "type" : "string"
          },
          "runId" : {
            "type" : "string"
          },
          "commandType" : {
            "type" : "string"
          },
          "status" : {
            "type" : "string"
          }
        },
        "required" : [
          "commandId",
          "runId",
          "commandType",
          "status"
        ],
        "description" : "异步控制命令的 `202 Accepted` 回执。\n`Accepted` 只表示命令已耐久接收，不表示 Agent 已完成；调用方应查询 `commandId` 或 `runId`。\n@param commandId\n本次耐久命令的唯一 ID，用于查询排队、执行、完成或死信状态\n@param runId\n命令所属 Run；创建命令第一次返回时客户端应同时保存它\n@param commandType\n稳定命令类别，例如 Start、Cancel、Recover 或 Retry\n@param status\n接收时状态，通常为 Queued；它不是 RunStatus"
      },
      "CommandView" : {
        "type" : "object",
        "properties" : {
          "commandType" : {
            "type" : "string"
          },
          "lastFailure" : {
            "type" : [
              "string",
              "null"
            ]
          },
          "commandId" : {
            "type" : "string"
          },
          "attempt" : {
            "type" : "integer",
            "format" : "int32"
          },
          "runId" : {
            "type" : "string"
          },
          "manualRetryCount" : {
            "type" : "integer",
            "format" : "int32"
          },
          "status" : {
            "type" : "string"
          }
        },
        "required" : [
          "commandId",
          "runId",
          "commandType",
          "status",
          "attempt",
          "manualRetryCount"
        ],
        "description" : "不暴露内部 payload、lease token、generation 或完整失败正文的命令查询视图。\n@param commandId\n命令唯一 ID\n@param runId\n目标 Run ID\n@param commandType\n稳定命令类别\n@param status\n当前耐久队列状态\n@param attempt\n当前人工重试周期内已经发生的自动 claim 次数\n@param manualRetryCount\n从 DeadLetter 被人工重新排队的累计次数\n@param lastFailure\n最近一次低敏失败摘要；不会包含 Provider 原文、用户输入或堆栈"
      },
      "ContextUsageView" : {
        "type" : "object",
        "properties" : {
          "droppedMemories" : {
            "type" : "integer",
            "format" : "int32"
          },
          "rotSignalCodes" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "estimatedTokens" : {
            "type" : "integer",
            "format" : "int64"
          },
          "droppedMessages" : {
            "type" : "integer",
            "format" : "int32"
          },
          "droppedRetrieval" : {
            "type" : "integer",
            "format" : "int32"
          },
          "truncatedToolResults" : {
            "type" : "integer",
            "format" : "int32"
          }
        },
        "required" : [
          "estimatedTokens",
          "droppedMessages",
          "truncatedToolResults",
          "droppedMemories",
          "droppedRetrieval",
