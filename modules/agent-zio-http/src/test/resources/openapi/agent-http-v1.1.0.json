      },
      "delete" : {
        "tags" : [
          "Runs"
        ],
        "description" : "耐久提交取消命令。\n\n- Runs\n",
        "parameters" : [
          {
            "name" : "runId",
            "in" : "path",
            "required" : true,
            "schema" : {
              "type" : "string"
            },
            "style" : "simple"
          }
        ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CancelCommand",
                "description" : "取消原因；允许 reason 为空，存在时最大 2,048 字符。\n\n"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CommandReceipt"
                }
              }
            }
          },
          "400" : {
            "description" : "稳定错误分类与可安全展示的消息；不会返回内部异常或 Provider 正文。\n\n",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/runs/{runId}/approval" : {
      "description" : "批准或拒绝当前等待中的工具动作。\n\n- Approvals\n",
      "post" : {
        "tags" : [
