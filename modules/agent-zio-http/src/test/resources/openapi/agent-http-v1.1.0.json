        "tags" : [
          "Events"
        ],
        "description" : "跨 Worker 可恢复的耐久 SSE；SSE data 是 RunEventView JSON。\n\n- Events\n",
        "parameters" : [
          {
            "name" : "runId",
            "in" : "path",
            "required" : true,
            "schema" : {
              "type" : "string"
            },
            "style" : "simple"
          },
          {
            "name" : "last-Event-ID",
            "in" : "header",
            "description" : "SSE 断点续传 sequence。\n\n",
            "schema" : {
              "type" : [
                "string",
                "null"
              ]
            },
            "style" : "simple"
          }
        ],
        "responses" : {
          "200" : {
            "content" : {
              "text/event-stream" : {
                "schema" : {
                  "type" : "array",
