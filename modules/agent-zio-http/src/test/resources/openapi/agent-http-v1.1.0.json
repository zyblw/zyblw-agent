            "required" : true,
            "schema" : {
              "type" : "string"
            },
            "style" : "simple"
          },
          {
            "name" : "last-Event-ID",
            "in" : "header",
            "description" : "已检查的最后 sequence；缺失表示从头读取。\n\n",
            "schema" : {
              "type" : [
                "string",
                "null"
              ]
            },
