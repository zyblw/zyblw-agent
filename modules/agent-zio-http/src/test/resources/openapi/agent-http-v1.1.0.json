{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "zyblw-agent API",
    "version" : "1.1.0"
  },
  "paths" : {
    "/api/v1/agents/{agentId}/runs" : {
      "description" : "异步创建 Agent Run；路径 agentId 最大 128 字符。\n\n- Runs\n",
      "post" : {
        "tags" : [
          "Runs"
        ],
        "description" : "异步创建 Agent Run；路径 agentId 最大 128 字符。\n\n- Runs\n",
        "parameters" : [
          {
            "name" : "agentId",
            "in" : "path",
            "required" : true,
            "schema" : {
              "type" : "string"
            },
            "style" : "simple"
          },
          {
            "name" : "idempotency-Key",
            "in" : "header",
            "description" : "客户端生成的稳定幂等键；重试必须复用，最大 256 字符。\n\n",
            "required" : true,
            "schema" : {
              "type" : "string"
            },
            "style" : "simple"
          }
        ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateRunRequest",
                "description" : "JSON 最大 256 KiB；线程最大 256 字符，输入最大 65,536 字符；身份由宿主认证上下文提供。\n\n"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "description" : "命令已耐久接收，尚未代表 Run 完成。\n\n",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CommandReceipt"
                }
              }
            }
          },
          "400" : {
            "description" : "稳定错误分类与可安全展示的消息；不会返回内部异常或 Provider 正文。\n\n",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/commands/{commandId}" : {
      "description" : "查询异步命令状态。\n\n- Commands\n",
      "get" : {
        "tags" : [
          "Commands"
        ],
        "description" : "查询异步命令状态。\n\n- Commands\n",
        "parameters" : [
          {
