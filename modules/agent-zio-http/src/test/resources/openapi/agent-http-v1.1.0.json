            }
          }
        }
      }
    },
    "/api/v1/runs/{runId}/retry" : {
      "description" : "提交带业务幂等 ID 的显式重试。\n\n- Runs\n",
      "post" : {
        "tags" : [
          "Runs"
        ],
        "description" : "提交带业务幂等 ID 的显式重试。\n\n- Runs\n",
        "parameters" : [
          {
            "name" : "runId",
            "in" : "path",
            "required" : true,
            "schema" : {
              "type" : "string"
            },
            "style" : "simple"
          }
        ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RetryRunCommand",
                "description" : "requestId 最大 256 字符，reason 最大 2,048 字符。\n\n"
              }
            }
          },
          "required" : true
        },
        "responses" : {
