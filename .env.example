# OpenAI 或 OpenAI-compatible 服务。不要提交真实密钥。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_ORGANIZATION=

# DeepSeek 官方 OpenAI-compatible API（勿把真实 Key 写入本文件或提交到仓库）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# 智谱 BigModel / GLM 官方 OpenAI-compatible API
GLM_API_KEY=
GLM_MODEL=glm-4.7-flash

# Anthropic Messages 原生协议
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_REQUEST_TIMEOUT=90s

# Google Gemini Interactions 原生协议
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1
GEMINI_REQUEST_TIMEOUT=90s

# 知识库 Embedding；聊天兼容服务不一定提供 /embeddings，请按实际厂商文档配置。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# 可选 Cohere v2 Reranker；未配置时可继续使用 identity 或业务自建 Reranker。
COHERE_API_KEY=
COHERE_BASE_URL=https://api.cohere.com
COHERE_RERANK_MODEL=rerank-v4.0-pro

# 可选长期记忆提炼模型；建议独立低成本模型，仍需具备工具调用能力和业务 eval。
MEMORY_EXTRACTOR_PROVIDER=
MEMORY_EXTRACTOR_MODEL=

# 可选模型辅助 Context 压缩。只有 AgentDefinition 选择 ModelAssisted 且应用使用 *WithContextCompressor 入口才会调用。
# API Key 仍复用所选 Provider Adapter 的 Secret，不在这些变量中重复配置。
ZYBLW_AGENT_CONTEXT_COMPRESSION_MODEL_PROVIDER=deepseek
ZYBLW_AGENT_CONTEXT_COMPRESSION_MODEL_MODEL=deepseek-v4-flash
ZYBLW_AGENT_CONTEXT_COMPRESSION_MODEL_MAX_OUTPUT_TOKENS=1200
ZYBLW_AGENT_CONTEXT_COMPRESSION_LIMITS_MAX_MESSAGES=96
ZYBLW_AGENT_CONTEXT_COMPRESSION_LIMITS_MAX_INPUT_CODE_POINTS=80000
ZYBLW_AGENT_CONTEXT_COMPRESSION_LIMITS_MAX_ITEMS=40
ZYBLW_AGENT_CONTEXT_COMPRESSION_LIMITS_MAX_EVIDENCE_QUOTE_CODE_POINTS=600
ZYBLW_AGENT_CONTEXT_COMPRESSION_LIMITS_MAX_REFERENCES_PER_ITEM=8
ZYBLW_AGENT_CONTEXT_COMPRESSION_LIMITS_MAX_ARGUMENTS_CHARACTERS=40000
ZYBLW_AGENT_CONTEXT_COMPRESSION_BEHAVIOR_REQUEST_TIMEOUT=20s
ZYBLW_AGENT_CONTEXT_COMPRESSION_BEHAVIOR_MAX_SCHEMA_REPAIRS=1
ZYBLW_AGENT_CONTEXT_COMPRESSION_BEHAVIOR_COMPRESSOR_VERSION=llm-extractive-v1
ZYBLW_AGENT_CONTEXT_COMPRESSION_BEHAVIOR_ALLOW_STANDALONE_TOOL_OUTPUT=false
ZYBLW_AGENT_CONTEXT_COMPRESSION_BEHAVIOR_DETERMINISTIC_FALLBACK=true

# 真实 Context 压缩小流量 smoke。ZYBLW_SMOKE_PROVIDER 复用 ProviderSmokeExample 的六类目标。
# 价格五项必须全部填写或全部留空；预发布 CI 建议全部填写，避免未知成本被当作已验证。
ZYBLW_SMOKE_PROVIDER=deepseek
ZYBLW_CONTEXT_SMOKE_REPETITIONS=3
ZYBLW_CONTEXT_SMOKE_TARGET_TOKENS=256
ZYBLW_CONTEXT_SMOKE_MAX_MODEL_CALLS=2
ZYBLW_CONTEXT_SMOKE_MAX_LATENCY_MILLIS=60000
ZYBLW_CONTEXT_SMOKE_MAX_INPUT_TOKENS=4000
ZYBLW_CONTEXT_SMOKE_MAX_OUTPUT_TOKENS=800
ZYBLW_CONTEXT_SMOKE_MAX_SUMMARY_CODE_POINTS=2000
ZYBLW_CONTEXT_SMOKE_MIN_STABILITY_PERCENT=100
ZYBLW_CONTEXT_SMOKE_PRICING_CURRENCY=
ZYBLW_CONTEXT_SMOKE_PRICING_VERSION=
ZYBLW_CONTEXT_SMOKE_INPUT_COST_PER_MILLION_MICROUNITS=
ZYBLW_CONTEXT_SMOKE_OUTPUT_COST_PER_MILLION_MICROUNITS=
ZYBLW_CONTEXT_SMOKE_MAX_COST_MICROUNITS=

# OpenTelemetry。Trace 可直发 Langfuse；Metrics 推荐先发 OTel Collector，再由 Prometheus 抓取。
OTEL_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
OTEL_SERVICE_NAME=zyblw-agent
OTEL_SERVICE_VERSION=dev
OTEL_DEPLOYMENT_ENVIRONMENT=development
OTEL_TRACE_SAMPLE_RATIO=1.0
OTEL_METRIC_EXPORT_INTERVAL_SECONDS=30

# Langfuse OTLP Trace。不要提交真实 public/secret key；生产从 Secret Manager 注入。
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# 低敏 Eval 发布门禁 CLI。上游只传 EvalSuiteSnapshot JSON，不传问题、答案、引用正文或 grade details。
# file 适合单节点 CI；postgres 适合多个流水线共享不可变基线。首次 bootstrap 默认禁止，只能人工显式开启一次。
ZYBLW_AGENT_EVAL_RELEASE_ARTIFACT_PATH=target/evals/candidate-snapshot.json
ZYBLW_AGENT_EVAL_RELEASE_ARTIFACT_MAX_BYTES=2097152
ZYBLW_AGENT_EVAL_RELEASE_STORE_BACKEND=file
ZYBLW_AGENT_EVAL_RELEASE_FILE_PATH=target/eval-trends/release.jsonl
ZYBLW_AGENT_EVAL_RELEASE_FILE_MAX_FILE_BYTES=67108864
ZYBLW_AGENT_EVAL_RELEASE_FILE_MAX_RECORD_BYTES=2097152
ZYBLW_AGENT_EVAL_RELEASE_POSTGRES_JDBC_URL=jdbc:postgresql://localhost:5432/zyblw
ZYBLW_AGENT_EVAL_RELEASE_POSTGRES_USER=zyblw_eval_release
ZYBLW_AGENT_EVAL_RELEASE_POSTGRES_PASSWORD=
ZYBLW_AGENT_EVAL_RELEASE_POSTGRES_CONNECT_TIMEOUT_SECONDS=10
ZYBLW_AGENT_EVAL_RELEASE_POSTGRES_MAX_SNAPSHOT_BYTES=2097152
ZYBLW_AGENT_EVAL_RELEASE_POSTGRES_MAX_HISTORY_LIMIT=100000
ZYBLW_AGENT_EVAL_RELEASE_POLICY_MAX_PASS_RATE_DROP=0.0
ZYBLW_AGENT_EVAL_RELEASE_POLICY_MAX_DIMENSION_SCORE_DROP=0.0
ZYBLW_AGENT_EVAL_RELEASE_POLICY_REQUIRE_CANDIDATE_HARD_GATES=true
ZYBLW_AGENT_EVAL_RELEASE_POLICY_REQUIRE_ALL_BASELINE_CASES=true
ZYBLW_AGENT_EVAL_RELEASE_POLICY_REQUIRE_ALL_BASELINE_DIMENSIONS=true
ZYBLW_AGENT_EVAL_RELEASE_POLICY_ALLOW_FIRST_PASSING_BASELINE=false

# Agent Runtime 治理参数（不含密钥）。空工具白名单表示拒绝全部工具。
ZYBLW_AGENT_TOOL_ALLOWED_TOOLS=
ZYBLW_AGENT_TOOL_DENIED_TOOLS=
ZYBLW_AGENT_TOOL_MAX_CALLS_PER_RUN=32
ZYBLW_AGENT_TOOL_MAX_CALLS_PER_STEP=8
ZYBLW_AGENT_TOOL_MAX_PARALLELISM=4
ZYBLW_AGENT_TOOL_DEFAULT_TIMEOUT=30s
ZYBLW_AGENT_TOOL_MAX_RESULT_BYTES=262144
ZYBLW_AGENT_TOOL_APPROVAL_POLICY=risk-based
ZYBLW_AGENT_TOOL_RETRY_MODE=never
ZYBLW_AGENT_TOOL_RETRY_MAX_ATTEMPTS=3
ZYBLW_AGENT_TOOL_RETRY_INITIAL_DELAY=200ms
ZYBLW_AGENT_TOOL_RETRY_MAX_DELAY=5s
ZYBLW_AGENT_TOOL_RETRY_JITTER=0.2
ZYBLW_AGENT_TOOL_RETRY_MAX_ELAPSED=20s

# Durable Worker claim/lease 参数；heartbeat 必须小于 lease。
ZYBLW_AGENT_WORKER_LEASE_DURATION=30s
ZYBLW_AGENT_WORKER_HEARTBEAT_EVERY=10s
ZYBLW_AGENT_WORKER_POLL_EVERY=500ms
ZYBLW_AGENT_WORKER_RETRY_DELAY=5s
ZYBLW_AGENT_WORKER_MAX_ATTEMPTS=8

# 独立 ZIO HTTP Agent 宿主的低敏发布标签与 readiness 硬超时；端口/TLS 使用 ZIO HTTP Server.Config。
ZYBLW_AGENT_HTTP_HOST_SERVICE_NAME=zyblw-agent
ZYBLW_AGENT_HTTP_HOST_SERVICE_VERSION=development
ZYBLW_AGENT_HTTP_HOST_ENVIRONMENT=development
ZYBLW_AGENT_HTTP_HOST_READINESS_TIMEOUT=2s
